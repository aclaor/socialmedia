{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipleey",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  // The database and the video bucket are created automatically on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "clipleey-db" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clipleey-media" }],
  "vars": {
    "SITE_NAME": "Clipleey",
    // Paste the codes from Google Search Console and Bing Webmaster Tools here (the content="" value only).
    "GOOGLE_SITE_VERIFICATION": "",
    "BING_SITE_VERIFICATION": "",
    // Optional: any 32-character hex string. Lets the site tell Bing about new videos instantly (IndexNow).
    "INDEXNOW_KEY": "",
    // Optional: comma-separated usernames who can review reports. The first account created is always an admin.
    "ADMIN_USERNAMES": ""
  },
  "observability": { "enabled": true }
}
